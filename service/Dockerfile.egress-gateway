# Egress Gateway Dockerfile
FROM oven/bun:1.3.14 AS base
WORKDIR /app

FROM base AS install
RUN mkdir -p /temp/dev
COPY service/package.json service/bun.lock /temp/dev/
RUN cd /temp/dev && bun install --frozen-lockfile

FROM base AS build
COPY --from=install /temp/dev/node_modules ./node_modules
COPY service/src ./src
COPY shared /shared
RUN bun build ./src/egress-gateway.ts --target=node --format=cjs --outfile=./egress-gateway.cjs

# The gateway runs the pre-bundled CJS artifact under Node, not Bun: the
# /external-fetch route emits an HTTP response trailer
# (X-CodeAPI-Egress-Outcome) and pins the connection IP through
# https.request({ lookup }), and Bun's node:http/node:https compat layer
# does not carry either faithfully. The production stage therefore bases on
# the Node image directly instead of grafting a node binary (and no shared
# library closure) into the bun image.
FROM node:22-slim AS production
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/egress-gateway.cjs ./egress-gateway.cjs
EXPOSE 3190
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3190/health || exit 1
CMD ["node", "egress-gateway.cjs"]

FROM base AS development
ENV NODE_ENV=development
COPY --from=install /temp/dev/node_modules node_modules
COPY service/src ./src
COPY shared /shared
EXPOSE 3190 9230
CMD ["bun", "run", "--watch", "src/egress-gateway.ts"]
