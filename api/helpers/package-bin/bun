#!/bin/sh
set -eu
wrapper_dir=/usr/local/lib/sandbox-fetch/package-bin
real=
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  if [ "$dir" != "$wrapper_dir" ] && [ -x "$dir/bun" ]; then
    real="$dir/bun"
    break
  fi
done
IFS=$old_ifs
if [ -z "$real" ]; then
  echo "Bun runtime is unavailable" >&2
  exit 127
fi
case "${1:-}" in
  add|install)
    command=$1
    shift
    root=/mnt/data/.optale-packages/bun
    mkdir -p "$root"
    if [ ! -f "$root/package.json" ]; then
      printf '%s\n' '{"name":"optale-job-packages","private":true}' > "$root/package.json"
    fi
    cd "$root"
    started=$(date +%s%3N)
    set +e
    env \
      HTTP_PROXY="${PACKAGE_PROXY_URL}" \
      HTTPS_PROXY="${PACKAGE_PROXY_URL}" \
      NO_PROXY=127.0.0.1,localhost \
      NODE_EXTRA_CA_CERTS=/run/codeapi/package-ca.pem \
      SSL_CERT_FILE=/run/codeapi/package-ca.pem \
      "$real" "$command" --exact --cafile /run/codeapi/package-ca.pem "$@"
    status=$?
    set -e
    ended=$(date +%s%3N)
    node /usr/local/lib/sandbox-fetch/package-invocation.cjs bun "$started" "$ended" "$status" "$command" "$@" || true
    exit "$status"
    ;;
  *) exec "$real" "$@" ;;
esac
